# ReachDisha Backend Environment Variables

PORT=3000

# Production Database Connection
# For cloud deployment, use a hosted MySQL database URI (e.g. from Aiven, TiDB Cloud, Railway, or PlanetScale)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?sslaccept=strict
DATABASE_URL="mysql://root:password@localhost:3306/psychometric_db"

# JWT Authentication Secrets (Generate secure, high-entropy 256-bit strings for production)
JWT_ACCESS_SECRET="replace_with_a_secure_jwt_access_secret_in_production"
JWT_REFRESH_SECRET="replace_with_a_secure_jwt_refresh_secret_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
