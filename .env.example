# ReachDisha Frontend Environment Variables

# In development or mobile LAN, the frontend automatically discovers the API.
# In production on Vercel:
# - If backend is deployed on Render/Railway/VPS, specify the full URL:
#   VITE_API_URL=https://your-backend-api.onrender.com/api
# - If frontend and backend are hosted together or proxied under /api, this can be omitted.
VITE_API_URL=https://your-backend-api.onrender.com/api
